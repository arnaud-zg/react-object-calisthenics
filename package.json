{
  "name": "react-object-calisthenics",
  "version": "0.1.0",
  "private": true,
  "description": "Demo shop illustrating Object Calisthenics in a React front end.",
  "homepage": "https://arnaud-zg.github.io/react-object-calisthenics/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnaud-zg/react-object-calisthenics.git"
  },
  "license": "MIT",
  "author": "Arnaud Zheng",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/prerender.mjs",
    "changeset": "changeset",
    "dev": "vite --port 3000",
    "format": "prettier --write . --cache --cache-location .cache/.prettiercache",
    "format:check": "prettier --check . --cache --cache-location .cache/.prettiercache",
    "lint": "eslint . --cache --cache-location .cache/.eslintcache",
    "lint:fix": "pnpm lint --fix",
    "lint:md": "remark . --frail --quiet",
    "prepare": "lefthook install",
    "preview": "vite preview",
    "release": "shiplane",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.vitest.json --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:md && pnpm format:check && pnpm test"
  },
  "prettier": "@arnaud-zg/configs/prettier",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/store": "^0.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immutable-instance": "^0.0.9",
    "lucide-react": "^1.39.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^6.2.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@arnaud-zg/configs": "0.4.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "1.62.1",
    "@shiplane/changesets": "0.6.0-nightly.12",
    "@shiplane/git": "0.6.0-nightly.12",
    "@shiplane/github": "0.6.0-nightly.12",
    "@shiplane/github-pages": "0.6.0-nightly.12",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.2.3",
    "prettier": "^3.10.1",
    "prettier-plugin-packagejson": "^3.1.0",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "shiplane": "0.6.0-nightly.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.23.4"
  }
}
